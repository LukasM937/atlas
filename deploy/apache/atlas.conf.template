# /etc/apache2/sites-available/__DOMAIN__.conf
#
# Generated from this template by deploy/setup.sh, which substitutes
# __DOMAIN__ and handles the certbot bootstrap order (minimal :80 vhost ->
# `certbot certonly --apache` for the cert files only -> this full vhost).
# Deploying by hand: `certbot certonly` (not `--apache`/`--nginx` autoconfig)
# gets you the cert files at the paths below without certbot touching Apache
# config at all — simplest to reason about, run configtest before reload.
#
# The backend binds 127.0.0.1:8787 and is never exposed directly.

<VirtualHost *:80>
    ServerName __DOMAIN__
    # ACME http-01 must stay reachable; everything else is redirected.
    RewriteEngine On
    RewriteCond %{REQUEST_URI} !^/\.well-known/acme-challenge/
    RewriteRule ^ https://%{SERVER_NAME}%{REQUEST_URI} [END,NE,R=permanent]
</VirtualHost>

<VirtualHost *:443>
    ServerName __DOMAIN__

    SSLEngine on
    SSLProtocol -all +TLSv1.2 +TLSv1.3
    SSLHonorCipherOrder off
    SSLSessionTickets off
    Protocols h2 http/1.1
    SSLCertificateFile /etc/letsencrypt/live/__DOMAIN__/fullchain.pem
    SSLCertificateKeyFile /etc/letsencrypt/live/__DOMAIN__/privkey.pem
    Include /etc/letsencrypt/options-ssl-apache.conf

    Header always set Strict-Transport-Security "max-age=63072000; includeSubDomains"
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "no-referrer"
    Header always set X-Frame-Options "DENY"
    Header always set Content-Security-Policy "default-src 'none'; frame-ancestors 'none'"
    Header unset Server
    ServerSignature Off
    TraceEnable Off

    # 1 MB is far more than any note write needs.
    LimitRequestBody 1048576
    <IfModule mod_reqtimeout.c>
        RequestReadTimeout header=10-20,MinRate=500 body=20,MinRate=500
    </IfModule>

    ProxyPreserveHost On
    ProxyTimeout 120
    ProxyBadHeader Ignore
    # never trust a client-supplied forwarding header
    RequestHeader unset X-Forwarded-For
    RequestHeader unset X-Real-IP

    # --- MCP: only Anthropic's outbound range may reach it -----------------
    # 160.79.104.0/21 is the published outbound range used for MCP tool calls.
    # RE-CHECK before applying; this is the one value here that can change.
    # If the connector fails to attach, do NOT widen this blindly — capture the
    # real source addresses from the log first.
    <Location "/mcp/">
        <RequireAny>
            Require ip 160.79.104.0/21
            # Require ip <your-home-/32>   # uncomment only while debugging
        </RequireAny>
    </Location>

    # --- REST facade: public on purpose ------------------------------------
    # Decision (2026-07-28): /api and /openapi.json must be reachable by
    # ChatGPT Actions, Anthropic's REST callers, and a future client-side
    # note-taking app — none of those have a fixed IP range the way the MCP
    # connector does, so an IP allowlist here isn't workable. Controls
    # instead: Bearer token required on every /api call (app.py `_auth`),
    # a per-IP rate limit and 1 MB body cap enforced both here and in the app
    # (defense in depth), fail2ban banning on 401/403 bursts
    # (deploy/fail2ban/), and TLS. This is two independent-ish controls
    # (token + rate/ban), not one — Phase 4's OAuth upgrade replaces the
    # token side without touching this.
    <Location "/api/">
        Require all granted
    </Location>

    <Location "/openapi.json">
        Require all granted
    </Location>

    <Location "/healthz">
        Require ip 127.0.0.1 ::1
    </Location>

    ProxyPass        / http://127.0.0.1:8787/ flushpackets=on
    ProxyPassReverse / http://127.0.0.1:8787/

    # --- logging: the bearer token is in the MCP path, so never log that path
    LogFormat "%h %l %u %t \"%m /mcp/[redacted] %H\" %>s %b" mcp_redacted
    SetEnvIf Request_URI "^/mcp" atlas_mcp_request
    CustomLog ${APACHE_LOG_DIR}/atlas-mcp.log mcp_redacted env=atlas_mcp_request
    CustomLog ${APACHE_LOG_DIR}/atlas.log combined env=!atlas_mcp_request
    # ErrorLog can still echo a URL on some failures — review it, do not ship it.
    ErrorLog ${APACHE_LOG_DIR}/atlas-error.log
    LogLevel warn
</VirtualHost>
