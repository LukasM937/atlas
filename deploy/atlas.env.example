# /etc/atlas/atlas.env  —  root:root 0600
# ATLAS_TOKEN=$(openssl rand -base64 32 | tr -d '/+=')
ATLAS_TOKEN=REPLACE_ME
ATLAS_ROOT=/var/lib/atlas
ATLAS_GIT=1
# clearance of the internet-facing process; do NOT raise this
ATLAS_MAX_SENSITIVITY=internal
ATLAS_AUDIT_LOG=/var/lib/atlas/audit.jsonl
PORT=8787

# --- OAuth (Phase 4, optional) ---------------------------------------------
# Leave all four unset to keep the /mcp/<ATLAS_TOKEN>/ path-secret scheme.
# Set all four to switch to GitHub-backed OAuth on a fixed /mcp path instead —
# see docs/ADR-001-auth.md. ATLAS_TOKEN above still guards the REST /api facade
# either way.
# ATLAS_PUBLIC_URL=https://atlas.example.com
# ATLAS_GITHUB_CLIENT_ID=REPLACE_ME
# ATLAS_GITHUB_CLIENT_SECRET=REPLACE_ME
# ATLAS_GITHUB_ALLOWED_USER=your-github-username
