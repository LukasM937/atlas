# /etc/atlas/atlas.env  —  root:root 0600
# ATLAS_TOKEN=$(openssl rand -base64 32 | tr -d '/+=')
ATLAS_TOKEN=REPLACE_ME
ATLAS_ROOT=/var/lib/atlas
ATLAS_GIT=1
# clearance of the internet-facing process; do NOT raise this
ATLAS_MAX_SENSITIVITY=internal
ATLAS_AUDIT_LOG=/var/lib/atlas/audit.jsonl
PORT=8787
